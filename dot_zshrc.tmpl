export PATH="$HOME/.local/bin:$PATH"

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git docker kubectl)

source "$ZSH/oh-my-zsh.sh"

alias dots='curl -fsLS dot.bwozniak.com | sh'

alias r='printf "\033c" &&'
alias ll='ls -lah'
alias scr='screen -r'

alias dcupb='docker compose up --build'
alias dcd='docker compose down'
alias dcdvr='docker compose down -v --remove-orphans'
alias dck='docker compose kill'
alias dsp='docker system prune -a -f'
alias dclf='docker compose logs -f'

alias st='stern'
alias sta="stern '.*'"
alias staa="stern -A '.*'"

alias k='kubectl'
alias kg='kubectl get'
alias kgp='kubectl get pods'
alias kga='kubectl get all'
alias kgaa='kubectl get all -A'
alias kt='kubectl top'
alias kctx='kubectx'
alias kns='kubens'

function gagcm() { gaa; function _gagcm_commit() { git commit -m "$*"; }; _gagcm_commit "$@"; }

ew() {
  local cmd="$*"
  local i=0
  while (( i++ < 16 )); do
    local first=${cmd%% *}
    (( ${+aliases[$first]} )) || break
    cmd="${aliases[$first]}${cmd#$first}"
  done
  eval "watch -d \"$cmd\""
}

{{ if eq .osid "darwin" -}}
audio() { osascript -e "set volume output volume $1"; }
{{ end -}}

[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
